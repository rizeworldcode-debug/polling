<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Bahadurpur Election Admin Panel</title>
  <HTA:APPLICATION 
    ID="BahadurpurAdminApp"
    APPLICATIONNAME="Bahadurpur Election Admin Panel"
    BORDER="thin"
    BORDERSTYLE="normal"
    CAPTION="yes"
    MAXIMIZEBUTTON="yes"
    MINIMIZEBUTTON="yes"
    SHOWINTASKBAR="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    WINDOWSTATE="maximize"
    SCROLL="auto"
    NAVIGABLE="yes">
  <script type="text/javascript">
    window.location.href = "dist/index.html";
  </script>
</head>
<body style="margin:0;padding:0;background:#0f172a;color:#ffffff;font-family:sans-serif;display:flex;align-items:center;justify-content:center;height:100vh;">
  <h2>Loading Bahadurpur Election Admin Panel...</h2>
</body>
</html>
